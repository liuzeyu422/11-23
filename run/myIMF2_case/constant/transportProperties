/*--------------------------------*- C++ -*----------------------------------*\
| transportProperties for myinterMixingFoam2                                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

/* phases 与 0/ 文件名一致 */
phases (polymer nitrogen volatiles);

// ===== polymer (alpha1) =====
polymer
{
    transportModel  CrossPowerLaw;
    
    nu0   nu0   [0 2 -1 0 0 0 0] 5.333e-5;
    nuInf nuInf [0 2 -1 0 0 0 0] 5.333e-5;
    m     m     [0 0 1 0 0 0 0]  1;
    n     n     [0 0 0 0 0 0 0]  1;

    // 四段式：名字 + 名字 + 维度 + 数值
    /*CrossPowerLawCoeffs
    {
        nu0   nu0   [0 2 -1 0 0 0 0] 5.333e-5;
        nuInf nuInf [0 2 -1 0 0 0 0] 5.333e-5;
        m     m     [0 0 1 0 0 0 0]  1;
        n     n     [0 0 0 0 0 0 0]  1;
    }*/

    rho   [1 -3 0 0 0 0 0] 900;
    cp    [0 2 -2 -1 0 0 0] 4316.7;
    Pr    [0 0 0 0 0 0 0]   460.448;
}

// ===== nitrogen (alpha2) =====
nitrogen
{
    transportModel  Newtonian;
    rho   [1 -3 0 0 0 0 0] 1.2;
    nu    [0 2 -1 0 0 0 0] 1.5417e-5;
    cp    [0 2 -2 -1 0 0 0] 1038;
    Pr    [0 0 0 0 0 0 0]   0.711222;
}

// ===== volatiles (alpha3) =====
volatiles
{
    transportModel  Newtonian;
    rho   [1 -3 0 0 0 0 0] 1.5;
    nu    [0 2 -1 0 0 0 0] 3.473e-5;
    cp    [0 2 -2 -1 0 0 0] 2900.3;
    Pr    [0 0 0 0 0 0 0]   7.5552815;
}

