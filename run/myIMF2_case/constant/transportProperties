/* D23 —— 用“四段式”让 >> 能读 */
//D23 D23 [0 2 -1 0 0 0 0] 1e-5;
D23 D23 [0 2 -1 0 0 0 0] 0;

/* 界面张力 */
sigma12 sigma12 [1 0 -2 0 0 0 0] 0.035;
sigma13 sigma13 [1 0 -2 0 0 0 0] 0.035;
sigma23 sigma23 [1 0 -2 0 0 0 0] 0;

// ===== parameters for Wallis drag =====
plateWidth   plateWidth   [0 1 0 0 0 0 0] 1.884;    // W，若是圆筒周长 2πR (R=0.3 m) 就是 1.884
dragBandAlphaMin 0.05;                 // interface band limits for drag建议收紧带宽，数值更稳
dragBandAlphaMax 0.95;


phaseChangeTwoPhaseMixture Merkle;
MerkleCoeffs
{
    // A_s = 9.24e19 / 60  [s^-1]
    preExp  preExp  [0 0 -1 0 0 0 0] 1.54e15; //论文中为1.54e18

    // EoverR = E/R = 314700/8.314  [K]
    EoverR  EoverR  [0 0 0 1 0 0 0] 3.785e4;
    
    // Optional guards (recommended):
    TminArr  TminArr  [0 0 0 1 0 0 0] 753;     // K  低于此温度不反应
    TmaxArr  TmaxArr  [0 0 0 1 0 0 0] 1200;    // K  阿累尼乌斯温度上限（可很大）
    TexpMin  TexpMin  [0 0 0 1 0 0 0] 300;     // K  指数分母下限，防止 T<=0
    lnExpMax  lnExpMax  [0 0 0 0 0 0 0] 50;      // 无量纲；指数上限保险
}
CdragWallis 0.01;
dragDeltaMin 1e-4;
dragDeltaMax 2e-3;
/* 饱和压（Pa）：此处对热解模型不使用，但保留以兼容接口 */
pSat pSat [1 -1 -2 0 0 0 0] 101325;

